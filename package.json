{
  "name": "cartref-commute",
  "private": true,
  "description": "Cartref Commute: when to leave for the office or home, Letchworth \u21c4 London.",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -p .",
    "check-docs": "node tools/check-docs.mjs",
    "ci": "node tools/ci-local.mjs",
    "test": "node tools/build.mjs && node tools/run-tests.mjs",
    "ios:sync": "node ios/scripts/stage-web.mjs && cap sync ios && node ios/scripts/fix-swift-package.mjs",
    "ios:test": "swift test --package-path ios/NativeCore && node ios/scripts/test-simulator.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.24.0",
    "jsdom": "24.1.0",
    "typescript": "^5.6.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  }
}
